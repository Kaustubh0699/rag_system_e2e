# ---- App ----
APP_NAME=bot-gpt-backend
ENV=dev
LOG_LEVEL=INFO

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./botgpt.db

# ---- LLM ----
# ollama | groq
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Groq (hosted)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Context / RAG ----
MAX_CONTEXT_TOKENS=8000
SUMMARY_TRIGGER_TOKENS=6000
HISTORY_WINDOW_TURNS=12
RAG_TOP_K=4
CHUNK_SIZE=900
CHUNK_OVERLAP=150
